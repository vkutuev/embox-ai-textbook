# NIIET-DEV-K1921VG1T HC-SR04 ultrasonic example
#
# Install: copy this directory into an Embox checkout:
#
#     cp -r hcsr04/ <embox>/src/cmds/example/
#
# then add the line below inside the conf block of
# platform/niiet/templates/k1921vg1t_dev/mods.conf.
#
# No extra modules are needed: GPIO is in the template, and TMR1 is
# configured directly from the command.
include embox.cmd.example.hcsr04.hcsr04
