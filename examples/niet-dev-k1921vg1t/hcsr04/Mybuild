package embox.cmd.example.hcsr04

@AutoCmd
@Cmd(name = "hcsr04",
	help = "HC-SR04 ultrasonic distance (TMR1-timed echo)",
	man = '''
		NAME
			hcsr04 - NIIET-DEV-K1921VG1T HC-SR04 distance sensor
		SYNOPSIS
			hcsr04 [samples]
		DESCRIPTION
			Triggers an HC-SR04 ultrasonic sensor and measures the
			ECHO pulse width with the TMR1 free-running counter to
			report distance in cm. Sensor powered from 3.3 V so its
			ECHO output is safe for the MCU pins.
		AUTHORS
			Embox AI textbook
	''')
module hcsr04 {
	source "hcsr04.c"

	depends embox.driver.gpio.core
}
