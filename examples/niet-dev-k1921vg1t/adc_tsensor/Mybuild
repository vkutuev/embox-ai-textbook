package embox.cmd.example.adc_tsensor

@AutoCmd
@Cmd(name = "tsensor",
	help = "Read the internal temperature sensor (ADC ch63)",
	man = '''
		NAME
			tsensor - NIIET-DEV-K1921VG1T internal temperature sensor
		SYNOPSIS
			tsensor [samples]
		DESCRIPTION
			Reads the VG1T internal temperature sensor via the ADC
			(channel 63, block 3) and prints the raw value, voltage,
			and temperature in degrees Celsius. No wiring needed.
		AUTHORS
			Embox AI textbook
	''')
module tsensor {
	source "tsensor.c"
}
