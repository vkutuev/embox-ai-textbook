package embox.cmd.example.dma_copy

@AutoCmd
@Cmd(name = "dma_copy",
	help = "Memory-to-memory DMA copy (DMA0)",
	man = '''
		NAME
			dma_copy - NIIET-DEV-K1921VG1T DMA memory-to-memory copy
		SYNOPSIS
			dma_copy
		DESCRIPTION
			Copies a buffer from RAM to RAM using DMA0 (memory
			requestor) without CPU involvement, then verifies the
			result. Demonstrates the Embox DMA "new" API.
		AUTHORS
			Embox AI textbook
	''')
module dma_copy {
	source "dma_copy.c"

	depends embox.driver.dma.dma_new
}
