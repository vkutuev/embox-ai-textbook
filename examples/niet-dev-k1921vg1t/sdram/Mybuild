package embox.cmd.example.sdram

@AutoCmd
@Cmd(name = "sdram",
	help = "Bring up and test the external SDRAM (32 MB)",
	man = '''
		NAME
			sdram - NIIET-DEV-K1921VG1T SDRAM bring-up and test
		SYNOPSIS
			sdram
		DESCRIPTION
			Configures the SDRAM controller (pins, clock, timing) for
			the board's 32 MB SDRAM at 0x80000000 and verifies it with
			a write/read test. No wiring needed.
		AUTHORS
			Embox AI textbook
	''')
module sdram {
	source "sdram.c"
}
