# NIIET-DEV-K1921VG1T PWM example
#
# Install: copy this directory into an Embox checkout:
#
#     cp -r pwm_demo/ <embox>/src/cmds/example/
#
# then add the line below inside the conf block of
# platform/niiet/templates/k1921vg1t_dev/mods.conf.
#
# The PWM driver itself is already enabled by the template:
#
#     include embox.driver.pwm.niiet_pwm_drv(vg1t_version=1)
#     include embox.driver.pwm.niiet_pwm1(base_addr=0x51009000)
#
# Note: PWM1 (TMR1) shares pins PA4-PA7 with SPI1 (pl022_spi1). In the
# stock template PWM1 wins those pins, but to be safe disable SPI1:
#
#     // include embox.driver.spi.pl022_spi1(...)
#     // include embox.driver.spi.spi1_dev0(...)
#
include embox.cmd.example.pwm_demo.pwm_demo
