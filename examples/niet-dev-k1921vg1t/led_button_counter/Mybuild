package embox.cmd.example.led_button_counter

@AutoCmd
@Cmd(name = "led_counter_poll",
	help = "LED counter driven by the USER button (polling variant)",
	man = '''
		NAME
			led_counter_poll - NIIET-DEV-K1921VG1T LED/button counter,
			polling variant
		SYNOPSIS
			led_counter_poll
		DESCRIPTION
			Increments a counter on every USER button press and shows
			it in binary on the four LEDs. The button is polled with
			software debounce.
		AUTHORS
			Embox AI textbook
	''')
module led_counter_poll {
	source "board.h"
	source "led_counter_poll.c"

	depends embox.driver.gpio.core
}

@AutoCmd
@Cmd(name = "led_counter_irq",
	help = "LED counter driven by the USER button (IRQ variant)",
	man = '''
		NAME
			led_counter_irq - NIIET-DEV-K1921VG1T LED/button counter,
			interrupt-driven variant
		SYNOPSIS
			led_counter_irq
		DESCRIPTION
			Increments a counter on every USER button press and shows
			it in binary on the four LEDs. The button is handled via a
			GPIO interrupt on both edges; only the edge into the
			pressed state is counted.
		AUTHORS
			Embox AI textbook
	''')
module led_counter_irq {
	source "board.h"
	source "led_counter_irq.c"

	depends embox.driver.gpio.core
}

@AutoCmd
@Cmd(name = "led_counter_input",
	help = "LED counter driven by the USER button (input subsystem variant)",
	man = '''
		NAME
			led_counter_input - NIIET-DEV-K1921VG1T LED/button counter,
			input-subsystem variant
		SYNOPSIS
			led_counter_input
		DESCRIPTION
			Increments a counter on every USER button press and shows
			it in binary on the four LEDs. Button events are read from
			/dev/input/user-bt produced by the gpio_button driver.
		AUTHORS
			Embox AI textbook
	''')
module led_counter_input {
	source "board.h"
	source "led_counter_input.c"

	depends embox.driver.gpio.core
	depends embox.driver.input.core
}
