# NIIET-DEV-K1921VG1T PCA9685 PWM example
#
# Install: copy this directory into an Embox checkout:
#
#     cp -r pca9685/ <embox>/src/cmds/example/
#
# then add the line below inside the conf block of
# platform/niiet/templates/k1921vg1t_dev/mods.conf.
#
# The I2C0 bus itself is already enabled by the k1921vg1t_dev template:
#
#     include embox.driver.i2c.niiet.vg015_i2c0(base_addr=0x52018000)
#     include embox.cmd.i2c_tools.i2cdetect   # (and i2cget/i2cset)
#
# so only the command needs adding:
include embox.cmd.example.pca9685.pca9685
