package embox.cmd.example.uart1_echo

@AutoCmd
@Cmd(name = "uart1_echo",
	help = "Echo bytes received on UART1 (ttyS1)",
	man = '''
		NAME
			uart1_echo - NIIET-DEV-K1921VG1T UART1 echo
		SYNOPSIS
			uart1_echo
		DESCRIPTION
			Echoes bytes received on /dev/ttyS1 (UART1, XP2 pins 1/3)
			back to the same device. Requires the pl011_ttyS1 module.
		AUTHORS
			Embox AI textbook
	''')
module uart1_echo {
	source "uart1_echo.c"
}
