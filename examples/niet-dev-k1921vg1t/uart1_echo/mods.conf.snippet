# NIIET-DEV-K1921VG1T UART1 echo example
#
# Install: copy this directory into an Embox checkout:
#
#     cp -r uart1_echo/ <embox>/src/cmds/example/
#
# then add the lines below inside the conf block of
# platform/niiet/templates/k1921vg1t_dev/mods.conf.
#
# Full instructions:
# docs/riscv/k1921vg1t/КФДЛ.441461.050/example-uart1-echo.md

# UART1 (ttyS1): XP2 pin 1 = PB4 = RX, pin 3 = PB5 = TX (alt function 3)
include embox.driver.serial.pl011_ttyS1(base_addr=0x52011000, irq_num=67)

# The echo command
include embox.cmd.example.uart1_echo.uart1_echo
